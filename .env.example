# Copier ce fichier vers .env et compléter avec vos identifiants

# ============================================================================
# JUDILIBRE (Jurisprudence)
# ============================================================================
# Obligatoire pour utiliser le serveur Judilibre
# Créer une application sur https://piste.gouv.fr/ et s'abonner à l'API Judilibre
JUDILIBRE_API_KEY=votre_cle_api

# ============================================================================
# LÉGIFRANCE (Textes légaux)
# ============================================================================
# Obligatoire pour utiliser le serveur Légifrance
# Créer une application sur https://piste.gouv.fr/ et s'abonner à l'API Légifrance
PISTE_CLIENT_ID=votre_client_id
PISTE_CLIENT_SECRET=votre_client_secret

# URLs par défaut (ne pas modifier sauf cas particulier)
PISTE_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token
PISTE_BASE_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app